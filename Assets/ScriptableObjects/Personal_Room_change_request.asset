  description: "\u0421\u0442\u0443\u0434\u0435\u043D\u0442 \u043F\u0440\u043E\u0441\u0438\u0442 \u043F\u0435\u0440\u0435\u0432\u0435\u0441\u0442\u0438 \u0435\u0433\u043E \u0432 \u0434\u0440\u0443\u0433\u0443\u044E \u043A\u043E\u043C\u043D\u0430\u0442\u0443: \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u0441\u043E\u0441\u0435\u0434 \u043D\u0435\u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u0439"
  baseWeight: 1
  requiresStudent: 1
  roomId: office1
